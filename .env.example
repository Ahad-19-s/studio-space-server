# StudioSpace API — copy to `.env` and fill in real values.
# Never commit the real `.env`.

# --- Database -------------------------------------------------------------
# MongoDB connection string (Atlas or local). MONGO_DB_URI is the one the
# server reads; MONGODB_URI is accepted as a fallback.
MONGO_DB_URI=mongodb://127.0.0.1:27017/studioSpace
MONGODB_URI=mongodb://127.0.0.1:27017/studioSpace

# --- Auth -----------------------------------------------------------------
# MUST match the client's BETTER_AUTH_SECRET exactly. The session cookie is
# signed with it, so a mismatch makes every cookie-authenticated request 401.
BETTER_AUTH_SECRET=change-me-32-chars-minimum-please
# Public URL of the Next.js client (used for CORS + trusted origins).
CLIENT_URL=http://localhost:3000
# Same value as CLIENT_URL; BetterAuth's baseURL on this server.
BETTER_AUTH_URL=http://localhost:3000

# --- Server ---------------------------------------------------------------
# Defaults to 8000 (matches the client's NEXT_PUBLIC_API_URL).
# Render injects this at runtime — do not set it there.
PORT=8000
