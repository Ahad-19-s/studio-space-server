# Server port
PORT=8000

# MongoDB connection string.
# The database name is fixed in the code: studioSpace
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/

# Frontend origin that is allowed to call this API with credentials
CLIENT_URL=http://localhost:5173

# Secret used by BetterAuth to sign session cookies and encrypt JWT keys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this backend. Use https:// in production.
BETTER_AUTH_URL=http://localhost:8000

# Fallback secret used only when BETTER_AUTH_SECRET is not set.
JWT_SECRET=replace-with-a-long-random-string

# Optional: set to "none" only when the frontend and backend run on
# different domains in production (requires https, secure cookies).
# COOKIE_SAMESITE=none
